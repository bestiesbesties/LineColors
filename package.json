{
  "name": "linecolors",
  "displayName": "LineColors",
  "publisher" : "bestiesbesties",
  "description": "Visually group lines of code together.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
 	"contributes": {
		"views": {
			"explorer": [
				{
					"type": "webview",
					"id": "lineColors.colorsView",
					"name": "Line Colors"
				}
			]
		},
		"commands": [
			{
				"command": "lineColors.addColor",
				"category": "Line Colors",
				"title": "Add Color"
			}
		]
	},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
